name: Verify Human Identity

on:
  workflow_dispatch:
    inputs:
      tag:
        description:'Hepyagam'
        required: true
        type: string
      target:
        description:'Hepyagam'
        required: true
        type: string
        default: main
      prerelease:
        description: 'Hepyagam'
        required: true
        type:      true
        default:'Hepyagam AI Agent'


jobs:
  verify:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repo
        uses: actions/checkout@v3

      - name: Setup Node.js
        uses: actions/setup-node@v3
        with:
          node-version: '20'

      - name: Step 1 - Install ClawHub skill
        run: npx clawhub@latest install verified-agent-identity

      - name: Install script dependencies
        run: |
          cd scripts
          npm install

      - name: Step 2 - Create new blochain Identity
        run: node scripts/createNewEthereumIdentity.js

      - name: Step 3 - Link Human to Agent
        run: |
          node scripts/manualLinkHumanToAgent.js --challenge '{"name": "Hepyagam", "description": "Hepyagam AI Agent"}'
